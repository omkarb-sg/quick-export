# quick-export test configuration.
# Copy this file to config/test.env and adjust. It is read by the live-Aras
# integration tests (npm run test:live) and the live Playwright tests.
# config/test.env is gitignored (it holds a password). These example values
# match the local 12sp9 dev instance used during development.

# --- Aras instance (used by live-Aras integration tests) ---
ARAS_URL=http://localhost/12sp9
ARAS_DATABASE=12sp9
ARAS_USER=admin
# Plaintext password. The OAuth token mint hashes it to MD5 as Aras requires.
ARAS_PASSWORD=innovator

# A known item that IS in a package, used for the byte-parity export test.
ARAS_TEST_ITEM_TYPE=Method
ARAS_TEST_ITEM_ID=08BE5CE05D8D45F5A11EFFE699A9C65D
ARAS_TEST_ITEM_KEYEDNAME=CheckFavoriteOwner
ARAS_TEST_ITEM_PACKAGE=com.aras.innovator.favorites

# A second instance for the multi-instance isolation test. If you only have one
# instance, leave these equal to the first — the test still exercises two
# concurrent exports; it just can't prove cross-instance isolation.
ARAS_URL_2=http://localhost/12sp9
ARAS_DATABASE_2=12sp9
ARAS_USER_2=admin
ARAS_PASSWORD_2=innovator

# --- Browser (used by live Playwright tests) ---
ARAS_CLIENT_URL=http://localhost/12sp9/Client/
